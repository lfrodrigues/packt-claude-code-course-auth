{
  "name": "auth-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "shell-quote": "^1.10.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @auth-app/api",
    "dev:web": "npm run dev -w @auth-app/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force",
    "typecheck:incremental": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project api --project web",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project api --project web",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "deps:sync": "node scripts/check-dep-sync.mjs",
    "knip": "knip",
    "semgrep": "pipx run semgrep scan --error --config p/typescript --config p/expressjs .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run deps:sync && npm run knip && npm run audit",
    "verify:full": "npm run verify && npm run test:coverage && npm run e2e && npm run semgrep",
    "smoke": "bash scripts/smoke.sh",
    "db:generate": "npm run db:generate -w @auth-app/api",
    "db:migrate": "npm run db:migrate -w @auth-app/api",
    "db:auth-schema": "npm run db:auth-schema -w @auth-app/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
