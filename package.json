{
  "name": "auth-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @auth-app/api",
    "dev:web": "npm run dev -w @auth-app/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project api --project web",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit",
    "db:generate": "npm run db:generate -w @auth-app/api",
    "db:migrate": "npm run db:migrate -w @auth-app/api",
    "db:auth-schema": "npm run db:auth-schema -w @auth-app/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
