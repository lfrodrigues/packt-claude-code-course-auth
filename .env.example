# Copy to .env — .env is gitignored AND gitleaks-scanned. Never commit a real one.
#
# Generate a real secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-at-least-32-chars-long!!
BETTER_AUTH_URL=http://localhost:3005

DATABASE_URL=postgresql://auth:auth@localhost:5432/auth_app
TEST_DATABASE_URL=postgresql://auth:auth@localhost:5432/auth_app_test

# Where the SPA runs. Used for CORS + Better Auth trustedOrigins.
WEB_ORIGIN=http://localhost:5173
PORT=3005
NODE_ENV=development
